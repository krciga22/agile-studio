/*
  This is an example secrets file for the Agile Studio Server.
  You can copy the secrets from this file to your own local 
  secrets.json.
*/
{
  "AUTH0_DOMAIN": "<your-auth0-domain>",
  "AUTH0_CLIENT_ID": "<your-auth0-client-id>",
  "AUTH0_CLIENT_SECRET": "<your-auth0-client-secret>",
  "AUTH0_AUDIENCE": "<your-auth0-audience>",
  "DB_HOST": "localhost",
  "DB_PORT": 33060,
  "DB_NAME": "agile-studio-server-db",
  "DB_USER": "agile-studio-server-db-user",
  "DB_PASS": "<your-db-password>"
}
